{
	"manifest_version": 2,
	"name": "Sync & Publish",
	"version": "1.6.3",
	"description": "Sync Zotero and Obsidian locally, then publish the complete research workspace through GitHub.",
	"homepage_url": "https://github.com/willkyu/zotero-sync-and-publish-plugin",
	"author": "situkangsayur, willkyu",
	"icons": {
		"48": "content/icons/github-48.svg",
		"96": "content/icons/github-96.svg"
	},
	"applications": {
		"zotero": {
			"id": "zotero-github-sync@situkangsayur.github.io",
			"update_url": "https://raw.githubusercontent.com/willkyu/zotero-sync-and-publish-plugin/main/update.json",
			"strict_min_version": "6.999",
			"strict_max_version": "10.*"
		}
	}
}
