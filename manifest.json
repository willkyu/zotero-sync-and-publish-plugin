{
	"manifest_version": 2,
	"name": "Zotero Quartz Workspace Sync",
	"version": "1.1.7",
	"description": "Coordinate Zotero, Better Notes, Obsidian and Quartz in one workspace using system Git or the GitHub API.",
	"homepage_url": "https://github.com/willkyu/zotero-quartz-github-plugin",
	"author": "situkangsayur, willkyu",
	"icons": {
		"48": "content/icons/github-48.svg",
		"96": "content/icons/github-96.svg"
	},
	"applications": {
		"zotero": {
			"id": "zotero-github-sync@situkangsayur.github.io",
			"update_url": "https://raw.githubusercontent.com/willkyu/zotero-quartz-github-plugin/main/update.json",
			"strict_min_version": "6.999",
			"strict_max_version": "10.*"
		}
	}
}
